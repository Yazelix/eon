{
  "resolved": {
    "agents": {
      "send_enter_delay_ms": 300,
      "terminal_access": "window",
      "send_typing_quiet_ms": 2000
    },
    "anima": {
      "duration_seconds": 3,
      "enabled": true,
      "style": "random"
    },
    "bar": {
      "cpu_average_seconds": 30,
      "cpu_critical_percent": 90,
      "cpu_notice_percent": 60,
      "cpu_temperature_critical_celsius": 95,
      "cpu_temperature_warning_celsius": 85,
      "cpu_warning_percent": 75,
      "disk_critical_percent": 90,
      "disk_notice_percent": 60,
      "disk_path": "~",
      "disk_warning_percent": 75,
      "ram_critical_percent": 90,
      "ram_notice_percent": 60,
      "ram_warning_percent": 75,
      "widgets": [
        "codex_quota_5h",
        "codex_quota_7d",
        "claude_quota_5h",
        "claude_quota_7d",
        "claude_quota_scoped",
        "cpu",
        "ram",
        "disk",
        "clock",
        "version"
      ]
    },
    "editor": {
      "open_in": "popup",
      "command": [
        "fixture-editor"
      ],
      "kind": "auto"
    },
    "popups": {
      "agent": {
        "command": "auto",
        "enabled": true,
        "keep_alive": true,
        "keybinding": "Alt+Shift+L",
        "label": "Fixture agent"
      },
      "anima": {
        "enabled": true,
        "keybinding": "Alt+Shift+A",
        "label": "Fixture anima"
      },
      "files": {
        "keybinding": "Alt+Shift+F",
        "label": "Files"
      },
      "git": {
        "command": [
          "fixture-git"
        ],
        "enabled": true,
        "keep_alive": true,
        "keybinding": "Alt+Shift+J",
        "label": "Fixture git"
      },
      "project": {
        "keybinding": "Alt+Z",
        "label": "Fixture project"
      }
    },
    "shell": {
      "atuin": true,
      "carapace": true,
      "command": [
        "eon-nu"
      ],
      "mise": true,
      "starship": true,
      "zoxide": true
    },
    "sidebar": {
      "enabled": true
    },
    "terminal": {
      "background_blur": true,
      "background_opacity": 0.8,
      "columns": 100,
      "cursor_trail_color": "preset:ice",
      "cursor_trail_duration": 1.5,
      "detect_local_hosts": true,
      "font_fallbacks": [],
      "font_family": "Iosevka",
      "font_size": 16.0,
      "line_height": 1.125,
      "padding_color": "extend",
      "pane_frames": true,
      "rows": 30
    },
    "session": {
      "animate_working_badge": true,
      "number_keys": true,
      "warning_close_last_tab": true
    },
    "panels": {
      "heading": "connected"
    }
  },
  "warnings": [
    "eon: ignoring unknown setting popup in config.toml",
    "eon: bar.show_version in config.toml is deprecated since v0.1.2; use bar.widgets",
    "eon: ignoring popups.files.command in config.toml: Files is Eon's packaged Yazi; move a custom Yazi to its own popup, such as [popups.yazi] command = [\"eon-yazi\"]"
  ]
}
