{
  "resolved": {
    "agents": {
      "send_enter_delay_ms": 300,
      "terminal_access": "window",
      "send_typing_quiet_ms": 2000
    },
    "anima": {
      "duration_seconds": 3,
      "enabled": true,
      "style": "random"
    },
    "bar": {
      "cpu_average_seconds": 30,
      "cpu_critical_percent": 90,
      "cpu_notice_percent": 60,
      "cpu_temperature_critical_celsius": 95,
      "cpu_temperature_warning_celsius": 85,
      "cpu_warning_percent": 75,
      "disk_critical_percent": 90,
      "disk_notice_percent": 60,
      "disk_path": "~",
      "disk_warning_percent": 75,
      "ram_critical_percent": 90,
      "ram_notice_percent": 60,
      "ram_warning_percent": 75,
      "widgets": [
        "cpu",
        "ram",
        "clock",
        "version"
      ]
    },
    "editor": {
      "command": [
        "fixture-editor"
      ]
    },
    "popups": {
      "agent": {
        "command": "auto",
        "enabled": true,
        "keep_alive": true,
        "keybinding": "Alt+Shift+L",
        "label": "Fixture agent"
      },
      "anima": {
        "enabled": true,
        "keybinding": "Alt+Shift+A",
        "label": "Fixture anima"
      },
      "files": {
        "keybinding": "Alt+Shift+Y",
        "label": "Fixture files"
      },
      "git": {
        "command": [
          "fixture-git"
        ],
        "enabled": true,
        "keep_alive": true,
        "keybinding": "Alt+Shift+J",
        "label": "Fixture git"
      },
      "monitor": {
        "command": [
          "btop"
        ],
        "enabled": true,
        "keep_alive": true,
        "keybinding": "Alt+Shift+O",
        "label": "Monitor"
      },
      "project": {
        "keybinding": "Alt+Z",
        "label": "Fixture project"
      }
    },
    "shell": {
      "atuin": true,
      "carapace": true,
      "command": [
        "eon-nu"
      ],
      "mise": true,
      "starship": true,
      "zoxide": true
    },
    "sidebar": {
      "enabled": true
    },
    "terminal": {
      "background_blur": true,
      "background_opacity": 0.8,
      "border_width": 1,
      "columns": 100,
      "cursor_trail_color": "preset:ice",
      "cursor_trail_duration": 1.5,
      "detect_local_hosts": true,
      "focus_border_width": 1,
      "focus_color": "custom:#b207fb",
      "font_fallbacks": [],
      "font_family": "Iosevka",
      "font_size": 16.0,
      "line_height": 1.125,
      "padding_color": "extend",
      "pane_frames": true,
      "rows": 30
    },
    "session": {
      "animate_working_badge": true,
      "number_keys": true,
      "warning_close_last_tab": true
    },
    "panels": {
      "heading": "notch"
    }
  },
  "warnings": [
    "eon: ignoring unknown setting popup in config.toml",
    "eon: ignoring unknown bar.widgets name \"codex_quota\" in config.toml",
    "eon: ignoring unknown bar.widgets name \"claude_quota\" in config.toml",
    "eon: ignoring [workspace] in config.toml: renamed to [session] in v0.1.20"
  ]
}
