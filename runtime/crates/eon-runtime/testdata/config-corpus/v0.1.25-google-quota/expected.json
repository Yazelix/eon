{
  "resolved": {
    "agents": {
      "send_enter_delay_ms": 300,
      "terminal_access": "window",
      "send_typing_quiet_ms": 2000
    },
    "anima": {
      "duration_seconds": 2,
      "enabled": true,
      "style": "fixture-animation"
    },
    "bar": {
      "cpu_average_seconds": 30,
      "cpu_critical_percent": 90,
      "cpu_notice_percent": 60,
      "cpu_temperature_critical_celsius": 95,
      "cpu_temperature_warning_celsius": 85,
      "cpu_warning_percent": 75,
      "disk_critical_percent": 90,
      "disk_notice_percent": 60,
      "disk_path": "~",
      "disk_warning_percent": 75,
      "gpu_interval_seconds": 30,
      "ram_critical_percent": 90,
      "ram_notice_percent": 60,
      "ram_warning_percent": 75,
      "widgets": [
        "clock",
        "google_quota:A,B:C:7d",
        "google_quota:Gemini Models:5h",
        "google_quota:Gemini Models:7d",
        "ram"
      ]
    },
    "editor": {
      "open_in": "popup",
      "command": [
        "fixture-editor"
      ],
      "kind": "auto"
    },
    "popups": {
      "agent": {
        "command": "auto",
        "enabled": true,
        "keep_alive": true,
        "keybinding": "Alt+Shift+L",
        "label": "Fixture agent"
      },
      "anima": {
        "enabled": true,
        "keybinding": "Alt+Shift+A",
        "label": "Fixture anima"
      },
      "files": {
        "keybinding": "Alt+Shift+Y",
        "label": "Fixture files"
      },
      "git": {
        "command": [
          "fixture-git"
        ],
        "enabled": true,
        "keep_alive": true,
        "keybinding": "Alt+Shift+J",
        "label": "Fixture git"
      },
      "project": {
        "keybinding": "Alt+Z",
        "label": "Fixture project"
      }
    },
    "shell": {
      "atuin": true,
      "carapace": true,
      "command": [
        "fixture-shell"
      ],
      "mise": true,
      "starship": true,
      "zoxide": true
    },
    "sidebar": {
      "enabled": true
    },
    "terminal": {
      "background_blur": true,
      "background_opacity": 0.6,
      "detect_local_hosts": true,
      "font_fallbacks": [],
      "padding_color": "extend",
      "pane_frames": true
    },
    "session": {
      "animate_working_badge": true,
      "number_keys": true,
      "warning_close_last_tab": true
    },
    "panels": {
      "heading": "connected"
    }
  },
  "warnings": [
    "eon: ignoring unknown bar.widgets name \"google_quota\" in config.toml",
    "eon: ignoring unknown bar.widgets name \"google_quota::5h\" in config.toml",
    "eon: ignoring unknown bar.widgets name \"google_quota:A:weekly\" in config.toml",
    "eon: ignoring unknown bar.widgets name \"future_quota\" in config.toml",
    "eon: ignoring unknown bar.widgets name \"future_quota\" in config.toml"
  ]
}
