+    #[test]
+    fn stress_run_stats_retains_earlier_failures() {
+        let run_case = |condition: StressCondition, first: RunStats, second: RunStats| {
+            let mut cx = DispatcherContext::new(
+                |_| {},
+                ReportUuid::new_v4(),
+                "default",
+                vec![],
+                1,
+                MaxFail::All,
+                crate::time::far_future_duration(),
+                Some(condition),
+                None,
+            );
+            for sub in [first, second] {
+                let progress = cx.stress_progress().expect("stress progress");
+                cx.stress_sub_run_started(progress);
+                cx.run_stats = sub;
+                cx.stress_sub_run_finished();
+            }
+            cx.run_stats().summarize_final()
+        };
+        let pass = RunStats { initial_run_count: 1, finished_count: 1, passed: 1, ..Default::default() };
+        let fail = RunStats { initial_run_count: 1, finished_count: 1, failed: 1, ..Default::default() };
+        let setup_fail = RunStats { setup_scripts_initial_count: 1, setup_scripts_finished_count: 1, setup_scripts_failed: 1, ..Default::default() };
+        let count = || StressCondition::Count(StressCount::Count { count: std::num::NonZero::new(2).unwrap() });
+        let dur = || StressCondition::Duration(Duration::from_secs(60));
+        let test_failed = FinalRunStats::Failed { kind: RunStatsFailureKind::Test { initial_run_count: 1, not_run: 0 } };
+
+        assert_eq!(run_case(count(), fail, pass), test_failed);
+        assert_eq!(run_case(dur(), fail, pass), test_failed);
+        assert_eq!(run_case(count(), setup_fail, pass), FinalRunStats::Failed { kind: RunStatsFailureKind::SetupScript });
+        assert_eq!(run_case(count(), pass, pass), FinalRunStats::Success);
+    }
+
