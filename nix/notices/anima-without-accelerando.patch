+#[cfg(all(test, eon_without_accelerando))]
+mod archive_tests {
+    use super::*;
+
+    #[test]
+    fn archive_excludes_accelerando_from_explicit_random_and_browse_selection() {
+        assert!(resolve_style("accelerando", None, "anima").is_err());
+        assert!(!SCREEN_STYLES.contains(&"accelerando"));
+        assert!(!SCREEN_RANDOM_STYLES.contains(&"accelerando"));
+        for index in 0..crate::random_animation_slot_count() {
+            assert_ne!(
+                crate::resolve_random_animation_style(Some(index)),
+                "accelerando"
+            );
+        }
+        for style in GAME_OF_LIFE_RANDOM_STYLES {
+            assert!(resolve_style(style, None, "anima").is_ok());
+        }
+        assert!(
+            ANIMATION_STYLES
+                .iter()
+                .any(|style| matches!(style, AnimationStyle::GameOfLife(_)))
+        );
+    }
