# First match wins. Lowering any tier needs Lucca's recorded approval, like a contract.
high    mode: old and new modes differ, both non-zero               mode change
high    mode: either mode 120000                                    symlink
high    mode: either mode 160000                                    submodule
high    mode: status T                                              type change
high    mode: status U                                              unmerged
high    path: **/CONTRACTS.md                                       contract
high    path: runtime/crates/eon-workspace-protocol/**              wire and protocol
