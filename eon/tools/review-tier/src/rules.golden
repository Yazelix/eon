medium  path: assets/**                                             asset
high    token in a medium .rs line: unsafe                          risky token: unsafe
high    token in a medium .rs line: pre_exec                        risky token: pre_exec
high    token in a medium .rs line: kill(                           risky token: kill(
high    token in a medium .rs line: killpg                          risky token: killpg
high    token in a medium .rs line: SIGKILL                         risky token: SIGKILL
high    token in a medium .rs line: SIGTERM                         risky token: SIGTERM
high    token in a medium .rs line: set_permissions                 risky token: set_permissions
high    token in a medium .rs line: from_mode                       risky token: from_mode
high    token in a medium .rs line: UnixListener::bind              risky token: UnixListener::bind
high    token in a medium .rs line: UnixDatagram::bind              risky token: UnixDatagram::bind
high    token in a medium .rs line: TcpListener::bind               risky token: TcpListener::bind
high    token in a medium .rs line: UdpSocket::bind                 risky token: UdpSocket::bind
low     path: .beads/issues.jsonl                                   planning
low     path: .beads/config.yaml                                    planning
low     path: .beads/metadata.json                                  planning
low     path: **/*.md                                               docs
high    low path with a mode other than 100644 or 000000            mode
medium  low .md path named in a .rs or .nix file                    Markdown read by code
high    anything else                                               not on the Medium or Low lists
