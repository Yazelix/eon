# Every fact: the per-fact lemma, with the future flag step computes.
def step_fits(state: Session.State, flags: Boundary.Flags, fact: Boundary.Fact) ->
  {Laws.view_check(Laws.view(state), fact, flags, Laws.acts(Laws.decided(Session.step(fact, flags, state))), Laws.ahead_of(fact, Laws.view_revision(Laws.view(state)))) == choose(Laws.view_check(Laws.view(state), fact, flags, Laws.acts(Laws.decided(Session.step(fact, flags, state))), Laws.ahead_of(fact, Laws.view_revision(Laws.view(state)))), Laws.view(Laws.after(Session.step(fact, flags, state)))) : Laws.View}:
  match state:
    case Session.State{session, shown, tracker}:
      match session:
        case Session.Session{life, written, observer, explicit, waiting, pointer, manage}:
          match life:
            case Orbit.Detached{lpid}:
              match pointer:
                case Session.Pointer{route, lit, copied}:
                  match shown:
                    case Session.Shown{+revision, was}:
                      match flags:
                        case Boundary.Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
                          match fact:
                            case Boundary.Started{+pid}:
                              fits_started(
                                pid, Orbit.Detached{lpid}, observer, waiting, Session.Pointer{route, lit, copied}, written, explicit, manage, tracker, revision, was, Session.future_of(Boundary.Started{pid}, revision), held, unanchored, clipboard_overflow, clipboard, routed, room, frame_room, alternate, above_live, tracking, shift, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh
                              )
                            case Boundary.Output{+foreground, +marks}:
                              fits_output(
                                foreground, marks, Orbit.Detached{lpid}, observer, waiting, Session.Pointer{route, lit, copied}, written, explicit, manage, tracker, revision, was, Session.future_of(Boundary.Output{foreground, marks}, revision), held, unanchored, clipboard_overflow, clipboard, routed, room, frame_room, alternate, above_live, tracking, shift, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh
                              )
                            case Boundary.PtyClosed{}:
                              fits_pty_closed(
                                Orbit.Detached{lpid}, observer, waiting, Session.Pointer{route, lit, copied}, written, explicit, manage, tracker, revision, was, Session.future_of(Boundary.PtyClosed{}, revision), held, unanchored, clipboard_overflow, clipboard, routed, room, frame_room, alternate, above_live, tracking, shift, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh
                              )
                            case Boundary.Peer{+message}:
                              fits_peer(
                                message, Orbit.Detached{lpid}, observer, waiting, Session.Pointer{route, lit, copied}, written, explicit, manage, tracker, revision, was, Session.future_of(Boundary.Peer{message}, revision), held, unanchored, clipboard_overflow, clipboard, routed, room, frame_room, alternate, above_live, tracking, shift, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh
                              )
                            case Boundary.Applied{+effect}:
                              fits_applied(
                                effect, Orbit.Detached{lpid}, observer, waiting, Session.Pointer{route, lit, copied}, written, explicit, manage, tracker, revision, was, Session.future_of(Boundary.Applied{effect}, revision), held, unanchored, clipboard_overflow, clipboard, routed, room, frame_room, alternate, above_live, tracking, shift, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh
                              )
                            case Boundary.Closed{+full}:
                              fits_closed(
                                full, Orbit.Detached{lpid}, observer, waiting, Session.Pointer{route, lit, copied}, written, explicit, manage, tracker, revision, was, Session.future_of(Boundary.Closed{full}, revision), held, unanchored, clipboard_overflow, clipboard, routed, room, frame_room, alternate, above_live, tracking, shift, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh
                              )
                            case Boundary.Pressured{}:
                              fits_pressured(
                                Orbit.Detached{lpid}, observer, waiting, Session.Pointer{route, lit, copied}, written, explicit, manage, tracker, revision, was, Session.future_of(Boundary.Pressured{}, revision), held, unanchored, clipboard_overflow, clipboard, routed, room, frame_room, alternate, above_live, tracking, shift, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh
                              )
                            case Boundary.Reaped{+status}:
                              fits_reaped(
                                status, Orbit.Detached{lpid}, observer, waiting, Session.Pointer{route, lit, copied}, written, explicit, manage, tracker, revision, was, Session.future_of(Boundary.Reaped{status}, revision), held, unanchored, clipboard_overflow, clipboard, routed, room, frame_room, alternate, above_live, tracking, shift, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh
