import Base
import ./revision.bend as Revision

# Generated by tools/boundary.rs from src/boundary.schema, which defines the
# boundary (docs/HOST.md); edit the schema and regenerate.

# A peer's first message, as Bend's admission policy hears it.
type FirstMessage is Data:
  FirstMessageHello{}
  FirstMessageObserveMetadata{}
  # A malformed message or another request, which `refuse_peer` answers.
  FirstMessageRefused{}
  # Another ORBS version, which gets no answer.
  FirstMessageUnsupported{}
  # A Hello in a run with management from a peer other than the process the
  # lease holder named: no lease or no name, or credentials or a process start
  # that could not be read or differ from the name (ORB-C3).
  FirstMessageStranger{}

# What applying one input request did.
type Effect is Data:
  # There was nothing to write.
  EffectQuiet{}
  # Bytes were queued for the PTY.
  EffectWrite{}
  EffectResize{}
  # The PTY input queue could not hold the input, so it took nothing.
  EffectFull{}
  # A key's bytes were queued for the PTY.
  EffectKey{}
  # The PTY is closed, so nothing was applied.
  EffectClosed{}

# Why the observer is gone or behind.
type ObserverLoss is Data:
  # It closed.
  ObserverLossClosed{}
  # Its send buffer is full.
  ObserverLossPressured{}
  # An I/O error or a header of another ORBS version.
  ObserverLossFailed{}

# A vertical preview's direction.
type Direction is Data:
  DirectionUp{}
  DirectionDown{}

# The state of the input a vertical wheel would send the terminal if routed:
# a mouse event under mouse tracking, otherwise an arrow key.
type WheelInput is Data:
  WheelInputFits{}
  # It encodes to nothing, as outside the terminal grid.
  WheelInputEmpty{}
  # The client's queue cannot take TerminalRouted.
  WheelInputNoOutcomeRoom{}
  # The PTY input queue cannot hold it.
  WheelInputPtyFull{}

# A pointer request.
type SelectionKind is Data:
  SelectionKindBegin{}
  SelectionKindUpdate{}
  SelectionKindFinish{}
  SelectionKindCancel{}
  SelectionKindCopy{}

# How the host selection phase or upward tick Bend asked for went.
type Selected is Data:
  # Applied a drag.
  SelectedApplied{}
  # Applied a release, which froze the selected text if a selection is
  # presented.
  SelectedFinished{}
  # Failed, and libghostty's gesture and selection were cleared.
  SelectedFailed{}
  # Applied a press, which began a host sequence.
  SelectedBegan{}
  # Applied an upward selection tick.
  SelectedTicked{}

# Whether an upward selection tick may run on the held gesture; Bend checks
# that a host sequence is held on the primary screen.
type TickState is Data:
  TickStateFits{}
  # The position is not in the top row.
  TickStateNotTopRow{}
  # The gesture's anchor is gone.
  TickStateAnchorLost{}

# One management event (ORB-C13).
type ManagementEvent is Data:
  # A connection waits for admission.
  ManagementEventConnect{}
  # An Acquire whose identity, record, peer and sockets matched.
  ManagementEventAcquireValid{}
  # An Acquire whose identity, record, peer or sockets did not match.
  ManagementEventAcquireInvalid{}
  ManagementEventStatus{}
  ManagementEventStop{}
  # A request that breaks framing: a bad header, or a payload over its kind's
  # bound.
  ManagementEventBad{}
  # The connection closed, was refused, or outlived its one-second bound.
  ManagementEventGone{}
  # A ReadVisible request (ORB-C17), reported only once no synchronized
  # update is held.
  ManagementEventRead{}
  # A lease input request (ORB-C5).
  ManagementEventInput{}
  # An AttachAllow request (ORB-C3, ORB-C13).
  ManagementEventAllow{}
  # A whole request that does not decode, or one sent while another was in
  # flight.
  ManagementEventInvalid{}

# Which process group the host found in the PTY's foreground when the PTY
# turn began, before it fed the turn's output to the terminal, or when it read
# a ProgramStatus request (ORB-C15).
type Foreground is Data:
  # None: the terminal has no foreground group, or the host could not ask.
  ForegroundUnknown{}
  # The direct child's own group.
  ForegroundChild{}
  # Another group.
  ForegroundOther{}

# Why Bend rejects a request with Failure. The host owns each reason's code
# and exact text.
type Reason is Data:
  # A vertical request arrived while another is deferred.
  ReasonVerticalBusy{}
  # A vertical request names a revision ahead of authority.
  ReasonVerticalAhead{}
  # The client's queue cannot take a scroll's whole outcome (ORB-C8).
  ReasonScrollNoRoom{}
  # A return to live output while the terminal owns scrolling.
  ReasonLiveOwned{}
  # The client's queue cannot take the live viewport's frame.
  ReasonLiveNoRoom{}
  # A routed wheel's input encodes to nothing, outside the terminal grid.
  ReasonWheelOutside{}
  # The client's queue cannot take a wheel's outcome.
  ReasonWheelNoRoom{}
  # A viewport wheel while a synchronized update is open.
  ReasonWheelSynchronized{}
  # A press names a revision ahead of authority.
  ReasonSelectionAhead{}
  # A press while a pointer sequence is active.
  ReasonSelectionActive{}
  # An update without an active sequence.
  ReasonUpdateIdle{}
  # A finish without an active sequence.
  ReasonFinishIdle{}
  # A copy without finished copied text.
  ReasonNoCopy{}
  # A host phase's position lies outside the viewport.
  ReasonSelectionOutside{}
  # The client's queue cannot take a host phase's answer and frame, or a
  # cancel's.
  ReasonSelectionNoRoom{}
  # The client's queue cannot take a terminal phase's answer.
  ReasonPointerNoRoom{}
  # The host selection phase failed.
  ReasonSelectionFailed{}
  # An upward selection tick without a held host gesture on the primary
  # screen.
  ReasonTickNoGesture{}
  # An upward selection tick outside the top row.
  ReasonTickNotTopRow{}
  # An upward selection tick whose gesture lost its anchor.
  ReasonAnchorLost{}
  # The client's queue cannot take a selection tick's whole scroll outcome
  # (ORB-C9).
  ReasonTickNoRoom{}
  # The attached client sent a role again.
  ReasonRoleRepeated{}
  # The PTY input queue cannot hold the client's input.
  ReasonPtyFull{}
  # The client's input came after the PTY closed.
  ReasonPtyClosed{}

# The flags word every fact carries; each flag's def below reads it.
type Flags is Data:
  Flags{held: Bool, routed: Bool, room: Bool, alternate: Bool, frame_room: Bool, above_live: Bool, clipboard: Bool, clipboard_overflow: Bool, tracking: Bool, shift: Bool, unanchored: Bool, result_frame_room: Bool, outside: Bool, host_room: Bool, terminal_room: Bool, pty_full: Bool, metadata_changed: Bool, metadata_fresh: Bool}

# One fact from the host.
type Fact is Data:
  # The child printed its READY line; peers may connect.
  Started{pid: U32}
  # PTY output was fed to the terminal: one 8 KiB read while a client is
  # attached, or reads until the PTY is empty, up to 512 KiB, while none is. The
  # host samples the foreground group before each read and ends the turn early
  # when it changes, so `foreground` held at the start of every read of the
  # turn. `marks` tells whether the output carried a primary prompt start
  # (OSC 133 A, or N or P without another prompt kind).
  Output{foreground: Foreground, marks: Bool}
  # The PTY reached end of file while the direct child lives; the host reads and
  # writes it no more and discards queued input. A live child may hold no
  # terminal descriptor for a while; until it exits, EIO only pauses reading for
  # 10 ms.
  PtyClosed{}
  # A peer's first message.
  Peer{message: FirstMessage}
  # The client's input, including mouse input other than the vertical wheel,
  # was applied.
  Applied{effect: Effect}
  # The client closed its side: fully, or only its write half.
  Closed{full: Bool}
  # The client's output passed its bound.
  Pressured{}
  # The child was reaped with this exit code: 1 for a signal.
  Reaped{status: U32}
  # The child was not reaped within two seconds.
  NotReaped{}
  # The session finished; Bend prints its result and exits.
  Finished{}
  # The attached client sent a role again.
  RoleRepeated{}
  # The client's request failed to decode: malformed, or of another ORBS
  # version.
  Refused{version: Bool}
  # The observer is gone or behind. Before an ObserveMetadata peer's fact, the
  # host reports a gone observer, or ObserverMessage, this way first.
  ObserverGone{loss: ObserverLoss}
  # Bend's synchronized-output watchdog fired.
  Expired{}
  # A vertical preview from the frame at `revision`, which may be ahead of
  # authority.
  PreviewVertical{revision: Revision.Revision, direction: Direction}
  # Replaces Started when `ORBIT_GUARDIAN_FAULT=1`: Bend prints
  # `FAULT pid=PID` and dies, so the containment check sees a fatal worker exit.
  Fault{pid: U32}
  # A physical vertical wheel.
  Wheel{input: WheelInput}
  # A pointer request. A press names the frame it was made on, at `revision`,
  # which may be ahead of authority; other kinds carry 0.
  Selection{kind: SelectionKind, revision: Revision.Revision}
  # The host selection phase or upward tick Bend asked for went this way, and
  # whether libghostty presents a host selection after it.
  Selected{outcome: Selected, presented: Bool}
  # An upward selection tick from the position whose F32 coordinates have the
  # bits `x` and `y`.
  Tick{state: TickState, x: U32, y: U32}
  # A management event (ORB-C13).
  Management{event: ManagementEvent}
  # The direct child exited and was reaped, which the host checks every turn and
  # at least every 100 ms, so a descendant that
  # holds the PTY open cannot hide the exit. The host first fed the PTY's
  # remaining output, at most four reads, to the terminal; `drained` tells
  # whether any arrived. The PTY is read and written no more.
  ChildExited{drained: Bool}
  # A connection arrived while another peer negotiates its role. The listener is
  # not watched again until Bend answers it.
  Crowded{}
  # The metadata observer sent a whole message header, which it may not; a
  # malformed header counts too.
  ObserverMessage{}
  # A scroll commit of `rows`, a 16-bit two's complement, from the frame at
  # `revision`, which may be ahead of authority.
  ScrollVertical{revision: Revision.Revision, rows: U32}
  # A return to live output.
  ReturnToLive{}
  # The lease's stop found the child already exited with this exit code, so
  # the run ends naturally.
  ExitedBeforeStop{status: U32}
  # A ProgramStatus request on the management connection (ORB-C15), with the
  # foreground group the host sampled when it read it, between PTY turns.
  ProgramStatus{foreground: Foreground}
  # The client's resource plane changed (ORB-C16): a queued frame references a
  # pending resource that has not started, a start left more to start, a
  # resource's last chunk was written, a resource retired, or whether one may
  # start, the cap is reached or a retirement is due changed. Reported only
  # while a client is attached.
  # `delivered` tells that a resource's last chunk was written since the last
  # report; `idle`, that the resource queue has room to start one: the child
  # runs, no transfer is in progress and its queued chunk payload is below the
  # bound; `capped`, that 1,024 resources are announced and their retirements
  # not yet written; `due`, that a resource awaits retirement.
  Resources{delivered: Bool, idle: Bool, capped: Bool, due: Bool}

# One line from the host: a fact and the flags it carries.
type Line is Data:
  Line{fact: Fact, flags: Flags}

# A synchronized update is open. Reading it arms Bend's watchdog the first
# time it is set.
def held(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      held

# Mouse tracking or alternate-screen mode 1007 routes the vertical wheel to
# the terminal.
def routed(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      routed

# The client's queue has room for a scroll outcome of any size.
def room(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      room

# The alternate screen is active.
def alternate(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      alternate

# The client's queue has room for a frame of any size.
def frame_room(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      frame_room

# The primary screen's viewport is above live output (sent with a key).
def above_live(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      above_live

# The PTY turn produced clipboard writes for the client.
def clipboard(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      clipboard

# The PTY turn's clipboard writes passed their bound of 64 writes or 1 MiB.
def clipboard_overflow(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      clipboard_overflow

# The terminal tracks the mouse (sent with a pointer request).
def tracking(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      tracking

# The pointer phase holds Shift.
def shift(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      shift

# PTY output left libghostty's click gesture without an anchor, or newly
# enabled mouse tracking, since the gesture was last cleared.
def unanchored(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      unanchored

# The client's queue can take an answer and a frame of any size, replacing
# nothing (sent with a pointer request).
def result_frame_room(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      result_frame_room

# The pointer phase's position lies outside the viewport.
def outside(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      outside

# The client's queue can take a host phase's answer, frame and copied text.
def host_room(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      host_room

# The client's queue can take a terminal phase's answer.
def terminal_room(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      terminal_room

# The PTY input queue cannot hold the phase's mouse input.
def pty_full(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      pty_full

# The terminal's title or working directory differs from the metadata last
# queued for the observer, or none was queued.
def metadata_changed(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      metadata_changed

# No metadata was queued for the observer since it was admitted.
def metadata_fresh(flags: Flags) -> Bool:
  match flags:
    case Flags{held, routed, room, alternate, frame_room, above_live, clipboard, clipboard_overflow, tracking, shift, unanchored, result_frame_room, outside, host_room, terminal_room, pty_full, metadata_changed, metadata_fresh}:
      metadata_fresh

def decode_bool(arg: U32) -> Maybe<&2, Bool>:
  match arg:
    case 0:
      Some{False{}}
    case 1:
      Some{True{}}
    case _:
      None{}

def decode_first_message(arg: U32) -> Maybe<&2, FirstMessage>:
  match arg:
    case 1:
      Some{FirstMessageHello{}}
    case 2:
      Some{FirstMessageObserveMetadata{}}
    case 3:
      Some{FirstMessageRefused{}}
    case 4:
      Some{FirstMessageUnsupported{}}
    case 5:
      Some{FirstMessageStranger{}}
    case _:
      None{}

def decode_effect(arg: U32) -> Maybe<&2, Effect>:
  match arg:
    case 0:
      Some{EffectQuiet{}}
    case 1:
      Some{EffectWrite{}}
    case 2:
      Some{EffectResize{}}
    case 3:
      Some{EffectFull{}}
    case 4:
      Some{EffectKey{}}
    case 5:
      Some{EffectClosed{}}
    case _:
      None{}

def decode_observer_loss(arg: U32) -> Maybe<&2, ObserverLoss>:
  match arg:
    case 1:
      Some{ObserverLossClosed{}}
    case 2:
      Some{ObserverLossPressured{}}
    case 3:
      Some{ObserverLossFailed{}}
    case _:
      None{}

def decode_direction(arg: U32) -> Maybe<&2, Direction>:
  match arg:
    case 0:
      Some{DirectionUp{}}
    case 1:
      Some{DirectionDown{}}
    case _:
      None{}

def decode_wheel_input(arg: U32) -> Maybe<&2, WheelInput>:
  match arg:
    case 0:
      Some{WheelInputFits{}}
    case 1:
      Some{WheelInputEmpty{}}
    case 2:
      Some{WheelInputNoOutcomeRoom{}}
    case 3:
      Some{WheelInputPtyFull{}}
    case _:
      None{}

def decode_selection_kind(arg: U32) -> Maybe<&2, SelectionKind>:
  match arg:
    case 0:
      Some{SelectionKindBegin{}}
    case 1:
      Some{SelectionKindUpdate{}}
    case 2:
      Some{SelectionKindFinish{}}
    case 3:
      Some{SelectionKindCancel{}}
    case 4:
      Some{SelectionKindCopy{}}
    case _:
      None{}

def decode_selected(arg: U32) -> Maybe<&2, Selected>:
  match arg:
    case 0:
      Some{SelectedApplied{}}
    case 1:
      Some{SelectedFinished{}}
    case 2:
      Some{SelectedFailed{}}
    case 3:
      Some{SelectedBegan{}}
    case 4:
      Some{SelectedTicked{}}
    case _:
      None{}

def decode_tick_state(arg: U32) -> Maybe<&2, TickState>:
  match arg:
    case 0:
      Some{TickStateFits{}}
    case 2:
      Some{TickStateNotTopRow{}}
    case 3:
      Some{TickStateAnchorLost{}}
    case _:
      None{}

def decode_management_event(arg: U32) -> Maybe<&2, ManagementEvent>:
  match arg:
    case 1:
      Some{ManagementEventConnect{}}
    case 2:
      Some{ManagementEventAcquireValid{}}
    case 3:
      Some{ManagementEventAcquireInvalid{}}
    case 4:
      Some{ManagementEventStatus{}}
    case 5:
      Some{ManagementEventStop{}}
    case 6:
      Some{ManagementEventBad{}}
    case 7:
      Some{ManagementEventGone{}}
    case 8:
      Some{ManagementEventRead{}}
    case 9:
      Some{ManagementEventInput{}}
    case 10:
      Some{ManagementEventAllow{}}
    case 11:
      Some{ManagementEventInvalid{}}
    case _:
      None{}

def decode_foreground(arg: U32) -> Maybe<&2, Foreground>:
  match arg:
    case 0:
      Some{ForegroundUnknown{}}
    case 1:
      Some{ForegroundChild{}}
    case 2:
      Some{ForegroundOther{}}
    case _:
      None{}

def fact_started(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        pid : U32 <- U32.read(a0)
        return Started{pid}
    case _:
      None{}

def fact_output(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Con{a1, Nil{}}}:
      do Maybe<&2, Fact>:
        foreground_word : U32 <- U32.read(a0)
        foreground : Foreground <- decode_foreground(foreground_word)
        marks_word : U32 <- U32.read(a1)
        marks : Bool <- decode_bool(marks_word)
        return Output{foreground, marks}
    case _:
      None{}

def fact_pty_closed(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{PtyClosed{}}
    case _:
      None{}

def fact_peer(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        message_word : U32 <- U32.read(a0)
        message : FirstMessage <- decode_first_message(message_word)
        return Peer{message}
    case _:
      None{}

def fact_applied(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        effect_word : U32 <- U32.read(a0)
        effect : Effect <- decode_effect(effect_word)
        return Applied{effect}
    case _:
      None{}

def fact_closed(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        full_word : U32 <- U32.read(a0)
        full : Bool <- decode_bool(full_word)
        return Closed{full}
    case _:
      None{}

def fact_pressured(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{Pressured{}}
    case _:
      None{}

def fact_reaped(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        status : U32 <- U32.read(a0)
        return Reaped{status}
    case _:
      None{}

def fact_not_reaped(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{NotReaped{}}
    case _:
      None{}

def fact_finished(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{Finished{}}
    case _:
      None{}

def fact_role_repeated(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{RoleRepeated{}}
    case _:
      None{}

def fact_refused(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        version_word : U32 <- U32.read(a0)
        version : Bool <- decode_bool(version_word)
        return Refused{version}
    case _:
      None{}

def fact_observer_gone(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        loss_word : U32 <- U32.read(a0)
        loss : ObserverLoss <- decode_observer_loss(loss_word)
        return ObserverGone{loss}
    case _:
      None{}

def fact_expired(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{Expired{}}
    case _:
      None{}

def fact_preview_vertical(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Con{a1, Con{a2, Nil{}}}}:
      do Maybe<&2, Fact>:
        revision_high : U32 <- U32.read(a0)
        revision_low : U32 <- U32.read(a1)
        direction_word : U32 <- U32.read(a2)
        direction : Direction <- decode_direction(direction_word)
        return PreviewVertical{Revision.Revision{revision_high, revision_low}, direction}
    case _:
      None{}

def fact_fault(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        pid : U32 <- U32.read(a0)
        return Fault{pid}
    case _:
      None{}

def fact_wheel(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        input_word : U32 <- U32.read(a0)
        input : WheelInput <- decode_wheel_input(input_word)
        return Wheel{input}
    case _:
      None{}

def fact_selection(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Con{a1, Con{a2, Nil{}}}}:
      do Maybe<&2, Fact>:
        kind_word : U32 <- U32.read(a0)
        kind : SelectionKind <- decode_selection_kind(kind_word)
        revision_high : U32 <- U32.read(a1)
        revision_low : U32 <- U32.read(a2)
        return Selection{kind, Revision.Revision{revision_high, revision_low}}
    case _:
      None{}

def fact_selected(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Con{a1, Nil{}}}:
      do Maybe<&2, Fact>:
        outcome_word : U32 <- U32.read(a0)
        outcome : Selected <- decode_selected(outcome_word)
        presented_word : U32 <- U32.read(a1)
        presented : Bool <- decode_bool(presented_word)
        return Selected{outcome, presented}
    case _:
      None{}

def fact_tick(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Con{a1, Con{a2, Nil{}}}}:
      do Maybe<&2, Fact>:
        state_word : U32 <- U32.read(a0)
        state : TickState <- decode_tick_state(state_word)
        x : U32 <- U32.read(a1)
        y : U32 <- U32.read(a2)
        return Tick{state, x, y}
    case _:
      None{}

def fact_management(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        event_word : U32 <- U32.read(a0)
        event : ManagementEvent <- decode_management_event(event_word)
        return Management{event}
    case _:
      None{}

def fact_child_exited(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        drained_word : U32 <- U32.read(a0)
        drained : Bool <- decode_bool(drained_word)
        return ChildExited{drained}
    case _:
      None{}

def fact_crowded(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{Crowded{}}
    case _:
      None{}

def fact_observer_message(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{ObserverMessage{}}
    case _:
      None{}

def fact_scroll_vertical(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Con{a1, Con{a2, Nil{}}}}:
      do Maybe<&2, Fact>:
        revision_high : U32 <- U32.read(a0)
        revision_low : U32 <- U32.read(a1)
        rows : U32 <- U32.read(a2)
        return ScrollVertical{Revision.Revision{revision_high, revision_low}, rows}
    case _:
      None{}

def fact_return_to_live(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Nil{}:
      Some{ReturnToLive{}}
    case _:
      None{}

def fact_exited_before_stop(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        status : U32 <- U32.read(a0)
        return ExitedBeforeStop{status}
    case _:
      None{}

def fact_program_status(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Nil{}}:
      do Maybe<&2, Fact>:
        foreground_word : U32 <- U32.read(a0)
        foreground : Foreground <- decode_foreground(foreground_word)
        return ProgramStatus{foreground}
    case _:
      None{}

def fact_resources(args: List<&2, String>) -> Maybe<&2, Fact>:
  match args:
    case Con{a0, Con{a1, Con{a2, Con{a3, Nil{}}}}}:
      do Maybe<&2, Fact>:
        delivered_word : U32 <- U32.read(a0)
        delivered : Bool <- decode_bool(delivered_word)
        idle_word : U32 <- U32.read(a1)
        idle : Bool <- decode_bool(idle_word)
        capped_word : U32 <- U32.read(a2)
        capped : Bool <- decode_bool(capped_word)
        due_word : U32 <- U32.read(a3)
        due : Bool <- decode_bool(due_word)
        return Resources{delivered, idle, capped, due}
    case _:
      None{}

def decode_fact(code: U32, args: List<&2, String>) -> Maybe<&2, Fact>:
  match code:
    case 0:
      fact_started(args)
    case 1:
      fact_output(args)
    case 2:
      fact_pty_closed(args)
    case 3:
      fact_peer(args)
    case 4:
      fact_applied(args)
    case 5:
      fact_closed(args)
    case 6:
      fact_pressured(args)
    case 7:
      fact_reaped(args)
    case 8:
      fact_not_reaped(args)
    case 9:
      fact_finished(args)
    case 11:
      fact_role_repeated(args)
    case 12:
      fact_refused(args)
    case 13:
      fact_observer_gone(args)
    case 14:
      fact_expired(args)
    case 15:
      fact_preview_vertical(args)
    case 16:
      fact_fault(args)
    case 17:
      fact_wheel(args)
    case 18:
      fact_selection(args)
    case 19:
      fact_selected(args)
    case 20:
      fact_tick(args)
    case 21:
      fact_management(args)
    case 22:
      fact_child_exited(args)
    case 23:
      fact_crowded(args)
    case 24:
      fact_observer_message(args)
    case 25:
      fact_scroll_vertical(args)
    case 26:
      fact_return_to_live(args)
    case 27:
      fact_exited_before_stop(args)
    case 28:
      fact_program_status(args)
    case 29:
      fact_resources(args)
    case _:
      None{}

def decode_bit(+word: U32, mask: U32) -> Bool:
  Bool.not(U32.is_zero(U32.and(word, mask)))

def decode_known_flags(known: Bool, +word: U32) -> Maybe<&2, Flags>:
  match known:
    case True{}:
      Some{Flags{decode_bit(word, 1), decode_bit(word, 2), decode_bit(word, 16), decode_bit(word, 64), decode_bit(word, 256), decode_bit(word, 512), decode_bit(word, 1024), decode_bit(word, 2048), decode_bit(word, 4096), decode_bit(word, 8192), decode_bit(word, 16384), decode_bit(word, 32768), decode_bit(word, 131072), decode_bit(word, 262144), decode_bit(word, 524288), decode_bit(word, 1048576), decode_bit(word, 2097152), decode_bit(word, 4194304)}}
    case False{}:
      None{}

# A word with a bit no flag names is malformed.
def decode_flags(+word: U32) -> Maybe<&2, Flags>:
  decode_known_flags(U32.is_zero(U32.and(word, 4286644396)), word)

def decode_words(words: List<&2, String>) -> Maybe<&2, Line>:
  match words:
    case Con{code, Con{flags, args}}:
      do Maybe<&2, Line>:
        number : U32 <- U32.read(code)
        word : U32 <- U32.read(flags)
        fact : Fact <- decode_fact(number, args)
        decoded : Flags <- decode_flags(word)
        return Line{fact, decoded}
    case _:
      None{}

# Decodes one fact line, `CODE FLAGS ARG...`; a malformed line is None.
def decode(text: String) -> Maybe<&2, Line>:
  decode_words(String.split(String.trim(text), ' '))

# One decision for the host.
type Decision is Data:
  # The worker's first answer, before any fact: the finish bound, the
  # pending-peer bound and the synchronized-output bound in milliseconds, the
  # interactive client's output bound in bytes, and the most chunk payload
  # bytes its separate resource queue holds (ORB-C16).
  Bounds{finish_ms: U32, peer_ms: U32, sync_ms: U32, output_bytes: U32, resource_bytes: U32}
  # Admits the pending peer as the interactive client (Attached).
  Attach{}
  # Admits the pending peer as the metadata observer (ObservingMetadata).
  Observing{}
  # Answers the pending peer Busy and closes it.
  Busy{}
  # Answers the pending peer Failure(Protocol) and closes it.
  Refuse{}
  # Closes the pending peer without an answer.
  Drop{}
  # Writes Busy to the connection of fact Crowded without waiting,
  # and closes it; the negotiating peer keeps its turn.
  TurnAway{}
  # Queues Failure(Protocol) behind the observer's metadata, with "metadata
  # observers cannot send messages" or the decoder's detail, and closes the
  # observer once it is written, within the finish bound; the slot is free at
  # once.
  RefuseObserver{}
  # Closes the observer.
  DropObserver{}
  # Sends Accepted.
  Accepted{}
  # Sends Failure for the reason and forgets the request being decided.
  Reject{reason: Reason}
  # Answers a refused request with Failure(Protocol) and the decoder's detail.
  RefuseRequest{}
  # Closes the interactive client; the child keeps running.
  Detach{}
  # Ends the attachment of a client Bend refused: it keeps writing its queued
  # output, its Failure included, for at most the finish bound before its
  # socket closes, while the slot is free at once.
  Dismiss{}
  # Publishes the current terminal as one canonical frame at `revision`.
  Frame{revision: Revision.Revision}
  # Queues `revision` and the current title and working directory for the
  # observer; reports ObserverGone instead if it cannot. `ordered` metadata
  # stays queued; other metadata replaces queued metadata that has not started.
  Metadata{revision: Revision.Revision, ordered: Bool}
  # Sends the PTY turn's clipboard writes in order, each as one ClipboardWrite
  # that no later frame replaces.
  Clipboard{}
  # Ends an open synchronized update and disarms the watchdog.
  Release{}
  # Moves the viewport to live output; the next frame shows it.
  Bottom{}
  # Sends a VerticalPreview at `revision` of the viewport in `direction`, or
  # TerminalRouted when `routed`.
  PreviewAnswer{direction: Direction, routed: Bool, revision: Revision.Revision}
  # Answers the wheel being decided. When `routed`, it queues the wheel's input
  # for the PTY and sends WheelOutcome::TerminalRouted; otherwise it moves the
  # viewport one row, clamped at the history edges, and sends
  # WheelOutcome::Viewport with the frame at `revision`.
  WheelAnswer{routed: Bool, revision: Revision.Revision}
  # Answers a scroll of `rows`, as in fact ScrollVertical: TerminalOwned when
  # `routed`, otherwise it moves the viewport and sends one ScrollOutcome with
  # the frame at `revision`.
  ScrollAnswer{rows: U32, routed: Bool, revision: Revision.Revision}
  # Moves the viewport to live output and publishes one frame at `revision`.
  LiveAnswer{revision: Revision.Revision}
  # Applies the pointer phase being decided to the host selection through
  # libghostty's gestures; a finish freezes the selected plain text. It drops
  # unstarted frames from the queue and sends fact Selected.
  SelectHost{}
  # Queues the phase's left-button mouse input for the PTY.
  SelectTerminal{}
  # Resets libghostty's gesture and clears the host selection, keeping the
  # frozen text. `advance` tells that a presented selection is cleared, for which
  # Bend advances the revision; the host does not read it.
  Unselect{advance: Bool}
  # Sends SelectionFinished naming `revision`, the revision of the finished
  # phase's frame.
  SelectionFinished{revision: Revision.Revision}
  # Sends the frozen text as CopiedText for the selection clipboard when
  # `selection`, otherwise for the standard one.
  Copied{selection: Bool}
  # Admits the waiting management connection under its one-second bound.
  ManageAdmit{}
  # Answers the waiting management connection Busy and closes it.
  ManageBusy{}
  # Answers the connection Lease, which ends its bound.
  ManageLease{}
  # Answers the connection Status, with the live identity.
  ManageStatus{}
  # Answers Failure(InvalidIdentity) and closes the connection once it is
  # written.
  ManageRejectIdentity{}
  # Answers Failure(InvalidRequest) and closes the connection once it is
  # written.
  ManageReject{}
  # Hangs up and reaps the child with the bounded shutdown, then sends fact
  # Reaped or NotReaped; a child that already exited is not hung up, and sends
  # fact ExitedBeforeStop.
  ManageStop{}
  # Waits up to two seconds for the child, then sends fact Reaped or NotReaped;
  # after ChildExited the child is already reaped.
  Reap{}
  # Gives the client, then a live observer, the finish bound each to take its
  # queued output and Exited with `status`, closes every peer, removes the
  # socket pathname, and sends fact Finished; the host then exits with `status`.
  # An `explicit` finish, of a stop through the lease, closes the client without
  # Exited, writes the explicit tombstone, answers the lease Stopped, and exits 0.
  Finish{status: U32, explicit: Bool}
  # Moves the viewport and the selection one row up from the tick's position, as
  # in fact Tick, sends one ScrollOutcome with the frame at `revision` and
  # reports Selected Ticked; a gesture that fails is cleared and reported as
  # Selected Failed, and sends nothing.
  TickAnswer{x: U32, y: U32, revision: Revision.Revision}
  # Reports the tick at this position again as fact Tick, since its gesture may
  # have ended while it waited.
  Retick{x: U32, y: U32}
  # Captures the terminal's clipboard writes from the next PTY turn on when
  # `on`, and refuses them otherwise (ORB-C11).
  Capture{on: Bool}
  # Applies the PTY turn's program status reports and clears to the records in
  # stream order (ORB-C15). When `edge`, it first drops the working and blocked
  # records, before any of the turn's output; when `marks`, it drops the
  # working and blocked records that exist at each of the turn's prompt marks,
  # so a report after a mark survives it.
  StatusLifetime{edge: Bool, marks: Bool}
  # Answers the connection ProgramStatus with the terminal's records, as many as
  # fit in 4 KiB in ORB-C15's fill order.
  ManageProgramStatus{}
  # Answers the connection Busy; the lease stays.
  ManageRefuse{}
  # Moves the client's resource plane (ORB-C16). When `retire`, it first queues
  # one retirement for each sent resource that left its screen's storage once
  # a frame written after that no longer references it, except while its own
  # transfer still queues chunks. When `start`, it starts the lowest-numbered
  # pending resource that the last queued frame references, if storage still
  # holds it at its generation: it copies its pixels out of storage, queues its
  # announcement, and queues its chunks as the resource queue's bound allows. A
  # resource whose copy fails is not started and loses its number.
  Transfer{start: Bool, retire: Bool}
  # Answers the connection Visible with the active screen's live area as plain
  # text, the screen, its size, title and working directory, at `revision`
  # (ORB-C17); an extraction that fails answers Refused(ReadFailed). The lease
  # stays.
  ManageRead{revision: Revision.Revision}
  # Writes the lease input request to the PTY input queue whole, encoded as an
  # attached client's paste or Enter would be, and answers Input, or answers
  # Refused with its reason and writes nothing (ORB-C5). The lease stays.
  ManageInput{}
  # Records the named process on the leased connection, replacing any earlier
  # name, and answers Allowed (ORB-C13).
  ManageAllow{}
  # Answers Refused(InvalidRequest); the lease stays.
  ManageDecline{}

def encode_bool(value: Bool) -> String:
  match value:
    case False{}:
      "0"
    case True{}:
      "1"

def encode_revision(value: Revision.Revision) -> String:
  match value:
    case Revision.Revision{high, low}:
      U32.show(high) ++ " " ++ U32.show(low)

def encode_direction(value: Direction) -> String:
  match value:
    case DirectionUp{}:
      "0"
    case DirectionDown{}:
      "1"

def encode_reason(value: Reason) -> String:
  match value:
    case ReasonVerticalBusy{}:
      "0"
    case ReasonVerticalAhead{}:
      "1"
    case ReasonScrollNoRoom{}:
      "2"
    case ReasonLiveOwned{}:
      "3"
    case ReasonLiveNoRoom{}:
      "4"
    case ReasonWheelOutside{}:
      "5"
    case ReasonWheelNoRoom{}:
      "6"
    case ReasonWheelSynchronized{}:
      "7"
    case ReasonSelectionAhead{}:
      "8"
    case ReasonSelectionActive{}:
      "9"
    case ReasonUpdateIdle{}:
      "10"
    case ReasonFinishIdle{}:
      "11"
    case ReasonNoCopy{}:
      "12"
    case ReasonSelectionOutside{}:
      "13"
    case ReasonSelectionNoRoom{}:
      "14"
    case ReasonPointerNoRoom{}:
      "15"
    case ReasonSelectionFailed{}:
      "16"
    case ReasonTickNoGesture{}:
      "17"
    case ReasonTickNotTopRow{}:
      "18"
    case ReasonAnchorLost{}:
      "19"
    case ReasonTickNoRoom{}:
      "20"
    case ReasonRoleRepeated{}:
      "21"
    case ReasonPtyFull{}:
      "22"
    case ReasonPtyClosed{}:
      "23"

def encode_decision(decision: Decision) -> String:
  match decision:
    case Bounds{finish_ms, peer_ms, sync_ms, output_bytes, resource_bytes}:
      "0" ++ " " ++ U32.show(finish_ms) ++ " " ++ U32.show(peer_ms) ++ " " ++ U32.show(sync_ms) ++ " " ++ U32.show(output_bytes) ++ " " ++ U32.show(resource_bytes) ++ "\n"
    case Attach{}:
      "1" ++ "\n"
    case Observing{}:
      "2" ++ "\n"
    case Busy{}:
      "3" ++ "\n"
    case Refuse{}:
      "4" ++ "\n"
    case Drop{}:
      "5" ++ "\n"
    case TurnAway{}:
      "6" ++ "\n"
    case RefuseObserver{}:
      "7" ++ "\n"
    case DropObserver{}:
      "8" ++ "\n"
    case Accepted{}:
      "9" ++ "\n"
    case Reject{reason}:
      "10" ++ " " ++ encode_reason(reason) ++ "\n"
    case RefuseRequest{}:
      "11" ++ "\n"
    case Detach{}:
      "12" ++ "\n"
    case Dismiss{}:
      "13" ++ "\n"
    case Frame{revision}:
      "14" ++ " " ++ encode_revision(revision) ++ "\n"
    case Metadata{revision, ordered}:
      "15" ++ " " ++ encode_revision(revision) ++ " " ++ encode_bool(ordered) ++ "\n"
    case Clipboard{}:
      "16" ++ "\n"
    case Release{}:
      "17" ++ "\n"
    case Bottom{}:
      "18" ++ "\n"
    case PreviewAnswer{direction, routed, revision}:
      "19" ++ " " ++ encode_direction(direction) ++ " " ++ encode_bool(routed) ++ " " ++ encode_revision(revision) ++ "\n"
    case WheelAnswer{routed, revision}:
      "20" ++ " " ++ encode_bool(routed) ++ " " ++ encode_revision(revision) ++ "\n"
    case ScrollAnswer{rows, routed, revision}:
      "21" ++ " " ++ U32.show(rows) ++ " " ++ encode_bool(routed) ++ " " ++ encode_revision(revision) ++ "\n"
    case LiveAnswer{revision}:
      "22" ++ " " ++ encode_revision(revision) ++ "\n"
    case SelectHost{}:
      "23" ++ "\n"
    case SelectTerminal{}:
      "24" ++ "\n"
    case Unselect{advance}:
      "25" ++ " " ++ encode_bool(advance) ++ "\n"
    case SelectionFinished{revision}:
      "26" ++ " " ++ encode_revision(revision) ++ "\n"
    case Copied{selection}:
      "27" ++ " " ++ encode_bool(selection) ++ "\n"
    case ManageAdmit{}:
      "28" ++ "\n"
    case ManageBusy{}:
      "29" ++ "\n"
    case ManageLease{}:
      "30" ++ "\n"
    case ManageStatus{}:
      "31" ++ "\n"
    case ManageRejectIdentity{}:
      "32" ++ "\n"
    case ManageReject{}:
      "33" ++ "\n"
    case ManageStop{}:
      "34" ++ "\n"
    case Reap{}:
      "35" ++ "\n"
    case Finish{status, explicit}:
      "36" ++ " " ++ U32.show(status) ++ " " ++ encode_bool(explicit) ++ "\n"
    case TickAnswer{x, y, revision}:
      "37" ++ " " ++ U32.show(x) ++ " " ++ U32.show(y) ++ " " ++ encode_revision(revision) ++ "\n"
    case Retick{x, y}:
      "38" ++ " " ++ U32.show(x) ++ " " ++ U32.show(y) ++ "\n"
    case Capture{on}:
      "39" ++ " " ++ encode_bool(on) ++ "\n"
    case StatusLifetime{edge, marks}:
      "40" ++ " " ++ encode_bool(edge) ++ " " ++ encode_bool(marks) ++ "\n"
    case ManageProgramStatus{}:
      "41" ++ "\n"
    case ManageRefuse{}:
      "42" ++ "\n"
    case Transfer{start, retire}:
      "43" ++ " " ++ encode_bool(start) ++ " " ++ encode_bool(retire) ++ "\n"
    case ManageRead{revision}:
      "44" ++ " " ++ encode_revision(revision) ++ "\n"
    case ManageInput{}:
      "45" ++ "\n"
    case ManageAllow{}:
      "46" ++ "\n"
    case ManageDecline{}:
      "47" ++ "\n"

# One answer: decisions, carried out in order.
def Decisions() -> Type:
  List<&2, Decision>

# Encodes one answer: a line per decision and the end line.
def encode(decisions: Decisions()) -> String:
  match decisions:
    case Nil{}:
      "end\n"
    case Con{decision, rest}:
      encode_decision(decision) ++ encode(rest)

# The line the worker writes before its first answer, naming the schema it
# was generated from; the host refuses a worker that names another.
def schema() -> String:
  "schema 1fb6dafe7e2c4ce3\n"
